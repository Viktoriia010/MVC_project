@model MvcProject.Models.Player
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">Реєстрація гравця</h2>
                    </div>
                    <div class="card-body">
                        <form asp-controller="Player"asp-action="Create"method="post">
                            <div class="mb-3"><label asp-for="Login" class="form-label">Your Login</label>
                            <input asp-for="Login" class="form-control" placeholder="Введіть логін" />
                            <span asp-validation-for="Login"class="text-danger"></span></div><div class="mb-3"><label asp-for="Email" class="form-label">Your Email
                            </label>
                            <input asp-for="Email"class="form-control"placeholder="example@gmail.com" /><span asp-validation-for="Email"class="text-danger"></span>
                        </div>
                        <div class="mb-3"><label asp-for="Age" class="form-label">Your Age
                            </label>
                            <input asp-for="Age"class="form-control"type="number"placeholder="Введіть ваш вік" /><span asp-validation-for="Age"class="text-danger">

                            </span></div>
                            <button type="submit" class="btn btn-primary w-100">Add Player
                        </button>
                        </form>
                        </div>
                        </div>
                        </div>
                        </div>
                        </div>